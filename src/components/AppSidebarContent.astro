---
import { CALCULATORS, LEDGERS } from '~/lib/catalogue'
---
{
  LEDGERS.map((l) => (
    <section>
      <h3>{l.label}</h3>
      <ul>
        {CALCULATORS.filter((c) => c.ledger === l.key).map((c) => (
          <li>
            <a href={`/calculators/${c.slug}/`}>{c.name}</a>
          </li>
        ))}
      </ul>
    </section>
  ))
}
<section>
  <h3>Reference</h3>
  <ul>
    <li><a href="/about/">About</a></li>
    <li><a href="/account/">Account</a></li>
    <li><a href="/legal/disclaimer/">SEBI disclaimer</a></li>
  </ul>
</section>
