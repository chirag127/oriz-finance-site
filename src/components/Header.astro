---
/*
 * Header — the desk-calculator's model plate. Two rows on a manila docket:
 *
 * Row 1: oriz.in wordmark (left) · controls (right): index ▾ · search · sign-in
 * Row 2 (mono docket line): MODEL RR-28 · finance.oriz.in (left) · TAPE dd.mm.yyyy (right)
 *
 * The home page IS the index, so there is no long nav — controls jump to the
 * catalogue, open the multi-search popover, and expose Clerk sign-in.
 * Auth is Clerk (public content ungated); StatusBanner from shared chrome.
 */
import MultiSearch from '@chirag127/astro-chrome/MultiSearch'
import StatusBanner from '@chirag127/astro-chrome/StatusBanner'
import AuthButton from '~/components/auth/AuthButton.tsx'
import Wordmark from '~/components/Wordmark.astro'

const now = new Date()
const dd = String(now.getDate()).padStart(2, '0')
const mm = String(now.getMonth() + 1).padStart(2, '0')
const yyyy = now.getFullYear()
const TAPE = `TAPE ${dd}.${mm}.${yyyy}`
---

<header class="hd">
  <StatusBanner client:load siteId="finance" />

  <div class="hd-row hd-row-1 spine">
    <Wordmark size={30} href="https://oriz.in" />
    <nav class="hd-controls mono" aria-label="Header controls">
      <a href="/#index" class="hd-ctrl">index&nbsp;▾</a>
      <span class="hd-ctrl search-mount">
        <MultiSearch client:idle titleSuffix=" — oriz" label="search" />
      </span>
      <span class="hd-ctrl hd-auth"><AuthButton client:idle /></span>
    </nav>
  </div>
  <hr class="hd-rule" aria-hidden="true" />
  <div class="hd-row hd-row-2 spine">
    <span class="hd-model mono">DWG. RR-28 · finance.oriz.in · India</span>
    <span class="hd-tape mono">{TAPE}</span>
  </div>
  <hr class="hairline" />
</header>

<style>
  .hd { background: transparent; }
  .hd-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 40px;
  }
  .hd-row-1 { padding-block: 0.5rem; }
  .hd-controls {
    display: inline-flex;
    align-items: center;
    gap: 1.1rem;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--ink);
  }
  .hd-ctrl { color: var(--ink); }
  .hd-ctrl:hover { color: var(--credit); }
  .hd-auth { display: inline-flex; align-items: center; }
  .hd-auth :global(.auth-signin) {
    background: transparent;
    border: 1px solid var(--rule);
    color: var(--ink);
    font: inherit;
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 0.2rem 0.6rem;
    border-radius: 3px;
    cursor: pointer;
  }
  .hd-auth :global(.auth-signin:hover) { border-color: var(--credit); color: var(--credit); }
  .hd-auth :global(.auth-signin:focus-visible) { outline: 2px solid var(--credit); outline-offset: 2px; }

  .hd-rule { height: 2px; background: var(--rule); border: 0; margin: 0; }

  .hd-row-2 { min-height: 26px; }
  .hd-model, .hd-tape {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-mute);
    font-feature-settings: 'tnum' 1, 'zero' 1, 'calt' 0;
  }

  @media (max-width: 600px) {
    .hd-controls { gap: 0.7rem; }
    .hd-model, .hd-tape { font-size: 9px; letter-spacing: 0.12em; }
  }

  /* MultiSearch popover — repainted in Ready Reckoner tokens. */
  .search-mount { position: relative; display: inline-flex; align-items: center; }
  .search-mount :global([data-oriz-multisearch='trigger']) {
    background: transparent; border: 0; padding: 0; color: var(--ink);
    font: inherit; font-family: var(--font-mono); font-size: 12px; cursor: pointer;
  }
  .search-mount :global([data-oriz-multisearch='trigger']:hover) { color: var(--credit); }
  .search-mount :global([data-oriz-multisearch='trigger']:focus-visible) { outline: 2px solid var(--credit); outline-offset: 2px; }
  .search-mount :global([data-oriz-multisearch='popover']) {
    position: absolute; right: 0; top: calc(100% + 0.35rem);
    background: var(--tape); border: 1px solid var(--rule);
    padding: 0.75rem; z-index: 50; min-width: 240px;
    font-family: var(--font-sans); font-size: 13px;
    box-shadow: 0 6px 24px color-mix(in oklab, var(--ink) 14%, transparent);
  }
  .search-mount :global([data-oriz-multisearch='query']) {
    font-family: var(--font-mono); font-size: 11px; color: var(--ink-mute);
    margin: 0 0 0.5rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--rule);
    text-overflow: ellipsis; overflow: hidden; white-space: nowrap; max-width: 220px;
  }
  .search-mount :global([data-oriz-multisearch='list']) { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.125rem; }
  .search-mount :global([data-oriz-multisearch='engine']) { display: flex; align-items: center; gap: 0.625rem; padding: 0.375rem 0.5rem; color: var(--ink); }
  .search-mount :global([data-oriz-multisearch='engine']:hover) { background: color-mix(in oklab, var(--credit) 14%, transparent); color: var(--credit); }
  .search-mount :global([data-oriz-multisearch='glyph']) {
    display: inline-flex; align-items: center; justify-content: center; width: 18px; height: 18px;
    font-family: var(--font-mono); font-size: 11px; color: var(--ink-mute); border: 1px solid var(--rule);
  }

  /* StatusBanner */
  :global([data-oriz-status]) {
    display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem;
    font-family: var(--font-sans); font-size: 13px; color: #fff;
    background: var(--credit); justify-content: center;
  }
  :global([data-oriz-status='partial_outage']) { background: #b8791f; }
  :global([data-oriz-status='major_outage']) { background: var(--debit); }
  :global([data-oriz-status='maintenance']) { background: var(--ink); }
  :global([data-oriz-status-link]) { color: inherit; text-decoration: underline; }
  :global([data-oriz-status-dismiss]) { margin-left: auto; background: transparent; border: 0; color: inherit; cursor: pointer; font-size: 16px; line-height: 1; padding: 0 0.25rem; }
</style>
