---
/*
 * Wordmark — "oriz.in" set as a stamped receipt header: the mark in the wide
 * display grotesque, a mono "·in" suffix, and a teal double-underscore
 * (the adding-machine total rule) struck beneath. Links to https://oriz.in.
 * Themed to the Ready Reckoner palette; distinct from the old serif+strike.
 */

interface Props {
  subtitle?: string
  size?: number
  href?: string | null
}

const { subtitle, size = 40, href = 'https://oriz.in' } = Astro.props
---

<a
  class="wm-link"
  href={href ?? 'https://oriz.in'}
  aria-label={subtitle ? `oriz.in / ${subtitle}` : 'oriz.in'}
  style={`--wm-size: ${size}px;`}
>
  <span class="wm">
    <span class="wm-mark">oriz</span><span class="wm-tld mono">.in</span>
  </span>
  {subtitle && <span class="wm-sub mono">{subtitle}</span>}
</a>

<style>
  .wm-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
  }
  .wm {
    display: inline-flex;
    align-items: baseline;
    position: relative;
    padding-bottom: 0.14em;
  }
  .wm-mark {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: var(--wm-size, 40px);
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--ink);
  }
  .wm-tld {
    font-size: calc(var(--wm-size, 40px) * 0.42);
    color: var(--ink-mute);
    letter-spacing: 0;
    margin-left: 0.08em;
  }
  /* The teal double-rule "total" underscore. */
  .wm::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    border-top: 1px solid var(--credit);
    border-bottom: 1px solid var(--credit);
  }
  .wm-link:hover .wm-mark { color: var(--credit); }
  .wm-link:focus-visible {
    outline: 2px solid var(--credit);
    outline-offset: 3px;
  }
  .wm-sub {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-mute);
  }
</style>
