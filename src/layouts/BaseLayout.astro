---
/*
 * BaseLayout — per-app shell for oriz-finance "The Ready Reckoner".
 *
 * Uses shared @chirag127 chrome (tokens.css + Header/Sidebar/Footer/BottomBar)
 * for MECHANISM; the LOOK is bespoke via ~/styles/global.css. Header + Wordmark
 * are per-app. Auth = Clerk (public content never gated). Firestore stores
 * saved scenarios keyed by Clerk user id.
 *
 * Fonts: Archivo Expanded (display masthead) + Public Sans (body) + Spline
 * Sans Mono (every figure, mandatory tnum + slashed zero).
 */
import '@chirag127/astro-shell/tokens.css'
import '~/styles/global.css'
import '~/styles/oriz-ui-overrides.css'
import BottomBar from '@chirag127/astro-chrome/BottomBar.astro'
import ConsentBanner from '@chirag127/astro-chrome/ConsentBanner.astro'
import Footer from '@chirag127/astro-chrome/Footer.astro'
import Sidebar from '@chirag127/astro-chrome/Sidebar.astro'
import AppSidebarContent from '~/components/AppSidebarContent.astro'
import Header from '~/components/Header.astro'
import JsonLd from '~/components/JsonLd.astro'
import { bottomBarActions } from '~/data/bottombar-actions'
import { SITE_CONFIG } from '~/lib/siteConfig'

interface Props {
  title?: string
  description?: string
  canonical?: string
  noindex?: boolean
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
}

const {
  title = `${SITE_CONFIG.name} — ${SITE_CONFIG.tagline}`,
  description = SITE_CONFIG.description,
  canonical = `${SITE_CONFIG.origin}${Astro.url.pathname}`,
  noindex = false,
  jsonLd,
} = Astro.props

const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${SITE_CONFIG.name} — oriz`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@chirag127" />
    <meta name="theme-color" content="#F2EFE6" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="alternate" type="application/rss+xml" title="oriz · RSS" href="/rss.xml" />
    <link rel="alternate" type="application/atom+xml" title="oriz · Atom" href="/atom.xml" />
    <link rel="alternate" type="application/feed+json" title="oriz · JSON Feed" href="/feed.json" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo+Expanded:wght@600;700;800&family=Public+Sans:ital,wght@0,400;0,600;0,700;1,400&family=Spline+Sans+Mono:wght@400;500;600&display=swap"
    />

    <JsonLd extra={jsonLd} pageUrl={canonical} />

    {
      adsenseClient && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
          crossorigin="anonymous"
        />
      )
    }

    {
      beaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${beaconToken}"}`}
        />
      )
    }
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <div class="layout-body has-sidebar">
      <Sidebar>
        <AppSidebarContent />
      </Sidebar>
      <main id="main" class="layout-main"><slot /></main>
    </div>
    <Footer />
    <BottomBar actions={bottomBarActions} />
    <ConsentBanner />

    <style>
      .layout-body { display: block; }
      .layout-main { min-height: 50vh; }
      .layout-body.has-sidebar { display: flex; align-items: flex-start; }
      .layout-body.has-sidebar .layout-main { flex: 1 1 auto; min-width: 0; }
      @media (max-width: 767px) {
        .layout-body.has-sidebar { display: block; }
        .layout-main { padding-bottom: 64px; }
      }
    </style>
  </body>
</html>
