---
/*
 * /account — Clerk sign-in + saved scenarios (Firestore, keyed by Clerk id).
 * Every calculator is fully usable without an account; this is the only gated
 * surface. One sign-in works across every oriz site.
 */
import ClerkAccountPanel from '~/components/ClerkAccountPanel.tsx'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { SITE_CONFIG } from '~/lib/siteConfig'
---

<BaseLayout
  title={`Account — ${SITE_CONFIG.name}`}
  description={`Sign in to ${SITE_CONFIG.name}. One account works across every oriz site.`}
  noindex={true}
>
  <header class="prose-spine page-head">
    <p class="eyebrow"><a href="/">finance</a> / account</p>
    <h1>Account</h1>
    <p class="lede">
      The calculators need no account. Sign in only to save a scenario and
      re-open it anywhere — one account across every oriz site.
    </p>
  </header>

  <section class="prose-spine acct">
    <ClerkAccountPanel client:only="react" />
  </section>
</BaseLayout>

<style>
  .acct { padding-block: 2rem 4rem; }
</style>
