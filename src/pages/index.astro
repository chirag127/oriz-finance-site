---
/*
 * Home — the desk-calculator's cover sheet.
 *
 * Hero THESIS: the live SIP printing onto a paper tally-roll (the most
 * characteristic artifact of the Indian shop-accountant). Below it, the
 * catalogue reads as a key-register: 28 calculators across 4 ledgers, each a
 * struck key with a live/soon plate.
 */
import InlineSIPCalculator from '~/components/InlineSIPCalculator.tsx'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { CALCULATORS, LEDGERS } from '~/lib/catalogue'
import { SITE_CONFIG } from '~/lib/siteConfig'

const liveCount = CALCULATORS.filter((c) => c.live).length

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: `${SITE_CONFIG.name} — oriz`,
  url: SITE_CONFIG.origin,
  description: SITE_CONFIG.description,
  publisher: { '@type': 'Person', name: 'Chirag Singhal', url: 'https://oriz.in' },
}
---

<BaseLayout jsonLd={jsonLd}>
  {/* ── Hero — masthead + live tape ── */}
  <section class="spine hero" aria-label="Ready Reckoner">
    <p class="hero-eyebrow mono">The Ready Reckoner · finance.oriz.in</p>
    <h1 class="hero-h">
      Type it.<br />Watch it print.
    </h1>
    <p class="hero-sub">
      <span class="num">{CALCULATORS.length}</span> personal-finance calculators for India —
      SIP, EMI, FIRE, FD, PPF, NPS, HRA, TDS, take-home. Every figure computes on the tape as
      you type. No sign-up, no advisor pitch, no numbers leaving your device.
    </p>

    <InlineSIPCalculator client:idle />
  </section>

  <hr class="hairline" />

  {/* ── Index — the key-register ── */}
  <section id="index" class="spine reg" aria-label="Calculator register">
    <div class="reg-head">
      <h2 class="reg-h mono">Register</h2>
      <p class="reg-count mono">
        <span class="num">{liveCount}</span>/<span class="num">{CALCULATORS.length}</span> keys live
      </p>
    </div>

    {LEDGERS.map((ledger, li) => (
      <div class="reg-ledger">
        <h3 class="reg-ledger-h">
          <span class="reg-ledger-no mono">L{String(li + 1).padStart(2, '0')}</span>
          {ledger.label}
        </h3>
        <ul class="reg-keys">
          {CALCULATORS.filter((c) => c.ledger === ledger.key).map((c) => (
            <li>
              <a class="key-row" href={`/calculators/${c.slug}/`}>
                <span class="key-name">{c.name}</span>
                <span class="key-brief">{c.brief}</span>
                <span class={`key-plate mono ${c.live ? 'is-live' : ''}`}>{c.live ? 'live' : 'soon'}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <hr class="hairline" />

  {/* ── Colophon ── */}
  <section class="spine note" aria-label="How this works">
    <h2 class="note-h mono">On the machine</h2>
    <div class="note-prose">
      <p>
        Every calculator runs in your browser — the formula, the year-by-year
        breakdown, all of it client-side. Inputs never leave your device.
        Sign-in is optional and only unlocks saving a scenario to re-open on
        another device; it works across every oriz site.
      </p>
      <p>
        A couple of pages carry a display ad to cover the domain renewal.
        Nothing is gated. <a href="/legal/disclaimer/">Read the SEBI disclaimer →</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 4rem) clamp(2rem, 5vw, 3rem);
  }
  .hero-eyebrow {
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: 0 0 1rem;
  }
  .hero-h {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: expanded;
    text-transform: uppercase;
    font-size: clamp(2.4rem, 8vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 1.25rem;
  }
  .hero-sub {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--ink-mute);
    margin: 0 0 2.25rem;
    max-width: 60ch;
  }

  /* ── Register ── */
  .reg { padding-block: clamp(2rem, 5vw, 3rem); }
  .reg-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 2px solid var(--rule);
    padding-bottom: 0.6rem;
  }
  .reg-h, .reg-count {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--ink-mute);
    margin: 0;
  }
  .reg-ledger { margin-top: 2rem; }
  .reg-ledger-h {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: expanded;
    text-transform: uppercase;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    color: var(--ink);
    letter-spacing: -0.005em;
    margin: 0 0 0.75rem;
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
  }
  .reg-ledger-no {
    font-size: 11px;
    color: var(--credit);
    letter-spacing: 0.12em;
    font-weight: 500;
  }
  .reg-keys {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }
  @media (min-width: 760px) {
    .reg-keys { grid-template-columns: repeat(2, 1fr); gap: 0.5rem 1.5rem; }
  }
  .key-row {
    display: grid;
    grid-template-columns: 1fr max-content;
    grid-template-areas: 'name plate' 'brief plate';
    align-items: center;
    gap: 0 0.75rem;
    padding: 0.55rem 0.75rem;
    background: var(--tape);
    border: 1px solid var(--rule);
    border-bottom-width: 2px;
    border-radius: 4px;
  }
  .key-row:hover {
    border-color: var(--credit);
    background: color-mix(in oklab, var(--credit) 6%, var(--tape));
  }
  .key-row:focus-visible { outline: 2px solid var(--credit); outline-offset: 2px; }
  .key-name { grid-area: name; font-weight: 700; font-size: 15px; color: var(--ink); }
  .key-brief { grid-area: brief; font-size: 12px; color: var(--ink-mute); line-height: 1.35; }
  .key-plate {
    grid-area: plate;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-mute);
    border: 1px solid var(--rule);
    padding: 0.15rem 0.4rem;
    border-radius: 2px;
  }
  .key-plate.is-live { color: var(--credit); border-color: color-mix(in oklab, var(--credit) 50%, var(--rule)); }

  /* ── Colophon ── */
  .note { padding-block: clamp(2rem, 5vw, 3rem) 2rem; }
  .note-h {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--ink-mute);
    margin: 0 0 1rem;
  }
  .note-prose p { color: var(--ink); line-height: 1.7; margin: 0 0 1rem; max-width: 64ch; }
  .note-prose a {
    color: var(--credit);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--credit) 50%, transparent);
    text-underline-offset: 3px;
  }
  .note-prose a:hover { text-decoration-color: var(--credit); }
</style>
